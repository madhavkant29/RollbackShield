# RollbackShield -- environment configuration template.
# Copy to .env for local reference; Spring Boot reads these as environment
# variables (see backend/src/main/resources/application.yml). Never commit
# a real .env, and never put real credentials in this repository.

# --- Region / account (never hard-code an account ID anywhere in code) ---
AWS_REGION=us-east-1

# --- Backend persistence / integration mode ---
# local:  in-memory + logging events + in-memory work queue (default; no AWS needed)
# aws:    dynamodb + eventbridge + sqs + Cognito JWT validation
SPRING_PROFILES_ACTIVE=local

# --- Required only when SPRING_PROFILES_ACTIVE=aws ---
ROLLBACKSHIELD_TABLE_NAME=rollbackshield
ROLLBACKSHIELD_EVENT_BUS=rollbackshield-events
ROLLBACKSHIELD_WORK_QUEUE_URL=
COGNITO_ISSUER_URI=

# --- Demo app / worker ---
ROLLBACKSHIELD_CONTROL_PLANE_URL=http://localhost:8080
