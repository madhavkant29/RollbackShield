# RollbackShield -- environment configuration template.
# Copy to .env for local reference; Spring Boot reads these as environment
# variables (see backend/src/main/resources/application.yml). Never commit
# a real .env, and never put real credentials in this repository.

# --- Region / account (never hard-code an account ID anywhere in code) ---
AWS_REGION=us-east-1

# --- Backend persistence / integration mode ---
# local:  in-memory + logging events + in-memory work queue (default; no AWS needed)
# aws:    dynamodb + eventbridge + sqs + Cognito JWT validation
SPRING_PROFILES_ACTIVE=local

# --- Required only when SPRING_PROFILES_ACTIVE=aws ---
ROLLBACKSHIELD_TABLE_NAME=rollbackshield
ROLLBACKSHIELD_EVENT_BUS=rollbackshield-events
ROLLBACKSHIELD_WORK_QUEUE_URL=
COGNITO_ISSUER_URI=

# --- Service credential (worker poll/redeem + SDK policy fetch) ---
# Under the 'local' profile this defaults to 'local-dev-service-credential';
# under 'aws' there is deliberately NO default -- set it from a secret store
# or those endpoints reject every caller (fail closed).
ROLLBACKSHIELD_SERVICE_CREDENTIAL=

# --- Demo app / worker ---
ROLLBACKSHIELD_CONTROL_PLANE_URL=http://localhost:8080

# --- Frontend (Next.js) ---
# Control-room API base; defaults to http://localhost:8080 in code.
NEXT_PUBLIC_ROLLBACKSHIELD_API_URL=http://localhost:8080
# Cognito Hosted UI sign-in. Set BOTH to enable it; leave blank under the
# local profile (the backend's LocalDevAuthFilter needs no token).
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/
# NEXT_PUBLIC_COGNITO_SCOPES=openid email profile
