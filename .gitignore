# ---------------------------------------------------------------------------
# RollbackShield -- repository-wide ignore rules.
# Never commit build output, dependencies, secrets, or editor state.
# ---------------------------------------------------------------------------

# --- Java / Maven -----------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- AWS CDK / CloudFormation ----------------------------------------------
cdk.out/
.cdk.staging/

# --- Environment / secrets (never commit real values) -----------------------
.env
.env.*
!.env.example

# --- IDE / editor -----------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / temp / runtime --------------------------------------------------
*.log
*.pid
*.tmp
tmp/

# --- Test / coverage --------------------------------------------------------
coverage/
surefire-reports/
failsafe-reports/

# --- CDK context (caches real account ids) ----------------------------------
infrastructure/cdk.context.json
